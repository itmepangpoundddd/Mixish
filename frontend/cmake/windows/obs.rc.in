IDI_ICON1 ICON DISCARDABLE "cmake/windows/mixish.ico"

1 VERSIONINFO
FILEVERSION ${OBS_VERSION_MAJOR},${OBS_VERSION_MINOR},${OBS_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Mixish"
      VALUE "FileDescription", "Mixish"
      VALUE "FileVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "InternalName", "mixish"
      VALUE "OriginalFilename", "obs64"
      VALUE "ProductName", "Mixish"
      VALUE "ProductVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "Comments", "Mixish, based on OBS Studio. Free and open source software for video recording and live streaming."
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
